rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Quotes: Publicly readable, write requires authenticated student
    match /quotes/{quoteId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // Public campus messages
    match /publicMessages/{messageId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }

    match /privateMessages/{messageId} {
      allow read, write: if isAuthenticated();
    }

    match /confessions/{confessionId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }

    // Memories & Polaroid Photos: Publicly viewable, upload requires authenticated student
    match /memories/{memoryId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // Media (Reels, Videos, Photos): Publicly viewable, post/upload/comment requires authenticated student
    match /media/{mediaId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    match /reels_and_videos/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    match /aiChats/{chatId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}


